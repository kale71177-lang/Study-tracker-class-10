                    { id: "hin2", book: "क्षितिज (काव्य)", title: "राम-लक्ष्मण-परशुराम संवाद (तुलसीदास)", targetDate: "" },
                    { id: "hin3", book: "क्षितिज (काव्य)", title: "आत्मकथ्य (जयशंकर प्रसाद)", targetDate: "" },
                    { id: "hin4", book: "क्षितिज (काव्य)", title: "उत्साह / अट नहीं रही है (निराला)", targetDate: "" },
                    { id: "hin5", book: "क्षितिज (काव्य)", title: "यह दंतुरित मुस्कान / फसल (नागार्जुन)", targetDate: "" },
                    { id: "hin6", book: "क्षितिज (काव्य)", title: "संगतकार (मंगलेश डबराल)", targetDate: "" },
                    { id: "hin7", book: "क्षितिज (गद्य)", title: "नेताजी का चश्मा (स्वयं प्रकाश)", targetDate: "" },
                    { id: "hin8", book: "क्षितिज (गद्य)", title: "बालगोबिन भगत (रामवृक्ष बेनीपुरी)", targetDate: "" },
                    { id: "hin9", book: "क्षितिज (गद्य)", title: "लखनवी अंदाज़ (यशपाल)", targetDate: "" },
                    { id: "hin10", book: "क्षितिज (गद्य)", title: "एक कहानी यह भी (मन्नू भंडारी)", targetDate: "" },
                    { id: "hin11", book: "क्षितिज (गद्य)", title: "नौबतखाने में इबादत (यतींद्र मिश्र)", targetDate: "" },
                    { id: "hin12", book: "क्षितिज (गद्य)", title: "संस्कृति (भदंत आनंद कौसल्यायन)", targetDate: "" },
                    { id: "hin13", book: "कृतिका", title: "माता का आँचल (शिवपूजन सहाय)", targetDate: "" },
                    { id: "hin14", book: "कृतिका", title: "साना-साना हाथ जोड़ि... (मधु कांकरिया)", targetDate: "" },
                    { id: "hin15", book: "कृतिका", title: "मैं क्यों लिखता हूँ? (अज्ञेय)", targetDate: "" }
                ]
            }
        ];

        let userProgress = JSON.parse(localStorage.getItem('cbse_progress')) || {};
        let customChapters = JSON.parse(localStorage.getItem('cbse_custom_chapters')) || {};
        let isDarkMode = JSON.parse(localStorage.getItem('cbse_dark_mode')) || false;

        function applyTheme() {
            if (isDarkMode) {
                document.body.classList.add('dark-mode');
                document.getElementById('theme-icon').innerText = '☀️';
                document.getElementById('theme-text').innerText = 'ಲೈಟ್ ಮೋಡ್';
            } else {
                document.body.classList.remove('dark-mode');
                document.getElementById('theme-icon').innerText = '🌙';
                document.getElementById('theme-text').innerText = 'ಡಾರ್ಕ್ ಮೋಡ್';
            }
        }

        function toggleTheme() {
            isDarkMode = !isDarkMode;
            localStorage.setItem('cbse_dark_mode', JSON.stringify(isDarkMode));
            applyTheme();
        }

        function saveData() {
            localStorage.setItem('cbse_progress', JSON.stringify(userProgress));
            localStorage.setItem('cbse_custom_chapters', JSON.stringify(customChapters));
        }

        function toggleChapter(chapterId) {
            userProgress[chapterId] = !userProgress[chapterId];
            saveData();
            render();
        }

        function addChapter(subjectId) {
            const titleInput = document.getElementById(`title-${subjectId}`);
            const bookInput = document.getElementById(`book-${subjectId}`);
            const dateInput = document.getElementById(`date-${subjectId}`);

            const title = titleInput.value.trim();
            const book = bookInput.value.trim() || "ಸಾಮಾನ್ಯ";
            const targetDate = dateInput.value;

            if (!title) {
                alert("ದಯವಿಟ್ಟು ಅಧ್ಯಾಯದ ಹೆಸರನ್ನು ನಮೂದಿಸಿ.");
                return;
            }

            const newId = 'custom_' + Date.now();
            if (!customChapters[subjectId]) {
                customChapters[subjectId] = [];
            }

            customChapters[subjectId].push({
                id: newId,
                book: book,
                title: title,
                targetDate: targetDate
            });

            titleInput.value = '';
            bookInput.value = '';
            dateInput.value = '';

            saveData();
            render();
        }

        function deleteChapter(subjectId, chapterId) {
            if (confirm("ಈ ಅಧ್ಯಾಯವನ್ನು ಅಳಿಸಲು ಬಯಸುತ್ತೀರಾ?")) {
                customChapters[subjectId] = customChapters[subjectId].filter(ch => ch.id !== chapterId);
                delete userProgress[chapterId];
                saveData();
                render();
            }
        }

        function resetProgress() {
            if (confirm("ಎಲ್ಲಾ ಪ್ರಗತಿ ಮತ್ತು ಕಸ್ಟಮ್ ಅಧ್ಯಾಯಗಳನ್ನು ಮರುಹೊಂದಿಸಲು ಬಯಸುತ್ತೀರಾ?")) {
                userProgress = {};
                customChapters = {};
                saveData();
                render();
            }
        }

        function switchTab(subjectId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            document.getElementById(`tab-btn-${subjectId}`).classList.add('active');
            document.getElementById(`tab-content-${subjectId}`).classList.add('active');
        }

        function render() {
            const tabsContainer = document.getElementById('tabs-container');
            const contentsContainer = document.getElementById('contents-container');

            let totalChapters = 0;
            let completedChapters = 0;

            const activeTabId = document.querySelector('.tab-btn.active')?.dataset.id || defaultData[0].id;

            tabsContainer.innerHTML = '';
            contentsContainer.innerHTML = '';

            defaultData.forEach((subject) => {
                const subjectCustoms = customChapters[subject.id] || [];
                const allSubjectChapters = [...subject.chapters, ...subjectCustoms];
                
                const subTotal = allSubjectChapters.length;
                let subCompleted = 0;

                allSubjectChapters.forEach(ch => {
                    totalChapters++;
                    if (userProgress[ch.id]) {
                        completedChapters++;
                        subCompleted++;
                    }
                });

                const subPct = subTotal === 0 ? 0 : Math.round((subCompleted / subTotal) * 100);

                const tabBtn = document.createElement('button');
                tabBtn.className = `tab-btn ${subject.id === activeTabId ? 'active' : ''}`;
                tabBtn.id = `tab-btn-${subject.id}`;
                tabBtn.dataset.id = subject.id;
                tabBtn.innerText = subject.name;
                tabBtn.onclick = () => switchTab(subject.id);
                tabsContainer.appendChild(tabBtn);

                const contentDiv = document.createElement('div');
                contentDiv.className = `tab-content ${subject.id === activeTabId ? 'active' : ''}`;
                contentDiv.id = `tab-content-${subject.id}`;

                let chapterItemsHTML = allSubjectChapters.map(ch => {
                    const isDone = !!userProgress[ch.id];
                    const isCustom = ch.id.startsWith('custom_');
                    const dateStr = ch.targetDate ? `ಗುರಿ: ${ch.targetDate}` : 'ದಿನಾಂಕವಿಲ್ಲ';
                    
                    return `
                        <div class="chapter-item ${isDone ? 'completed' : ''}">
                            <div class="chapter-info" onclick="toggleChapter('${ch.id}')" style="cursor: pointer;">
                                <input type="checkbox" ${isDone ? 'checked' : ''} onclick="event.stopPropagation(); toggleChapter('${ch.id}')">
                                <span class="chapter-title">${ch.title}</span>
                            </div>
                            <div class="meta-info">
                                <span class="book-badge">${ch.book}</span>
                                <span class="date-badge">${dateStr}</span>
                                ${isCustom ? `<button class="delete-btn" onclick="deleteChapter('${subject.id}', '${ch.id}')" title="ಅಳಿಸು">×</button>` : ''}
                            </div>
                        </div>
                    `;
                }).join('');

                contentDiv.innerHTML = `
                    <div class="subject-overview">
                        <div>
                            <h3>${subject.name} ಪ್ರಗತಿ</h3>
                            <p style="color: var(--text-secondary); font-size: 0.85rem;">${subCompleted} / ${subTotal} ಪೂರ್ಣಗೊಂಡಿದೆ</p>
                        </div>
                        <span style="font-weight: bold; font-size: 1.1rem; color: var(--accent-color);">${subPct}%</span>
                    </div>

                    <div class="add-chapter-box">
                        <h4>ಹೊಸ ಅಧ್ಯಾಯವನ್ನು ಸೇರಿಸಿ</h4>
                        <div class="form-row">
                            <input type="text" id="title-${subject.id}" placeholder="ಅಧ್ಯಾಯದ ಹೆಸರು">
                            <input type="text" id="book-${subject.id}" placeholder="ವಿಭಾಗ/ಪುಸ್ತಕ (ಉದಾ: ಇತಿಹಾಸ)">
                            <input type="date" id="date-${subject.id}">
                            <button onclick="addChapter('${subject.id}')">ಸೇರಿಸಿ</button>
                        </div>
                    </div>

                    <div class="chapter-list">${chapterItemsHTML || '<p style="color: var(--text-secondary); text-align: center; padding: 10px;">ಯಾವ ಅಧ್ಯಾಯಗಳಿಲ್ಲ</p>'}</div>
                `;

                contentsContainer.appendChild(contentDiv);
            });

            const overallPct = totalChapters === 0 ? 0 : Math.round((completedChapters / totalChapters) * 100);
            document.getElementById('overall-percentage').innerText = `${overallPct}%`;
            document.getElementById('overall-progress-bar').style.width = `${overallPct}%`;
        }

        applyTheme();
        render();
    </script>
</body>
</html>
