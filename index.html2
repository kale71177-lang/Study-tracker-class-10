                name: "ಇಂಗ್ಲಿಷ್ (English)",
                chapters: [
                    { id: "eng1", book: "First Flight", title: "A Letter to God", targetDate: "" },
                    { id: "eng2", book: "First Flight", title: "Nelson Mandela: Long Walk to Freedom", targetDate: "" },
                    { id: "eng3", book: "First Flight", title: "Two Stories about Flying", targetDate: "" },
                    { id: "eng4", book: "First Flight", title: "From the Diary of Anne Frank", targetDate: "" },
                    { id: "eng5", book: "First Flight", title: "Glimpses of India", targetDate: "" },
                    { id: "eng6", book: "First Flight", title: "Mijbil the Otter", targetDate: "" },
                    { id: "eng7", book: "First Flight", title: "Madam Rides the Bus", targetDate: "" },
                    { id: "eng8", book: "First Flight", title: "The Sermon at Benares", targetDate: "" },
                    { id: "eng9", book: "First Flight", title: "The Proposal (Play)", targetDate: "" },
