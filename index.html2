                    { id: "eng12", book: "Poetry", title: "A Tiger in the Zoo", targetDate: "" },
                    { id: "eng13", book: "Poetry", title: "How to Tell Wild Animals", targetDate: "" },
                    { id: "eng14", book: "Poetry", title: "The Ball Poem", targetDate: "" },
                    { id: "eng15", book: "Poetry", title: "Amanda!", targetDate: "" },
                    { id: "eng16", book: "Poetry", title: "The Trees", targetDate: "" },
                    { id: "eng17", book: "Poetry", title: "Fog", targetDate: "" },
                    { id: "eng18", book: "Poetry", title: "The Tale of Custard the Dragon", targetDate: "" },
                    { id: "eng19", book: "Poetry", title: "For Anne Gregory", targetDate: "" },
                    { id: "eng20", book: "Footprints", title: "A Triumph of Surgery", targetDate: "" },
                    { id: "eng21", book: "Footprints", title: "The Thief's Story", targetDate: "" },
                    { id: "eng22", book: "Footprints", title: "The Midnight Visitor", targetDate: "" },
                    { id: "eng23", book: "Footprints", title: "A Question of Trust", targetDate: "" },
                    { id: "eng24", book: "Footprints", title: "Footprints without Feet", targetDate: "" },
                    { id: "eng25", book: "Footprints", title: "The Making of a Scientist", targetDate: "" },
                    { id: "eng26", book: "Footprints", title: "The Necklace", targetDate: "" },
                    { id: "eng27", book: "Footprints", title: "Bholi", targetDate: "" },
                    { id: "eng28", book: "Footprints", title: "The Book That Saved the Earth", targetDate: "" }
                ]
            },
            {
                id: "hindi",
                name: "ಹಿಂದಿ (Hindi Course-A)",
                chapters: [
