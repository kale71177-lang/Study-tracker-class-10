                    { id: "sst16", book: "ರಾಜ್ಯಶಾಸ್ತ್ರ", title: "Political Parties", targetDate: "" },
                    { id: "sst17", book: "ರಾಜ್ಯಶಾಸ್ತ್ರ", title: "Outcomes of Democracy", targetDate: "" },
                    { id: "sst18", book: "ಅರ್ಥಶಾಸ್ತ್ರ", title: "Development", targetDate: "" },
                    { id: "sst19", book: "ಅರ್ಥಶಾಸ್ತ್ರ", title: "Sectors of the Indian Economy", targetDate: "" },
                    { id: "sst20", book: "ಅರ್ಥಶಾಸ್ತ್ರ", title: "Money and Credit", targetDate: "" },
                    { id: "sst21", book: "ಅರ್ಥಶಾಸ್ತ್ರ", title: "Globalization and the Indian Economy", targetDate: "" },
                    { id: "sst22", book: "ಅರ್ಥಶಾಸ್ತ್ರ", title: "Consumer Rights", targetDate: "" }
                ]
            },
            {
